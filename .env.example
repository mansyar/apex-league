# Copy to `.env` (gitignored) and edit. Every value here is optional. Bun loads
# `.env` into the environment for `bun run`, so an entry here reaches the Vite
# config; exporting the variable in your shell works too.
#
# Extra Host headers the Vite dev server accepts, comma-separated. Only needed
# for remote dev — e.g. serving `bun run dev` through Tailscale Serve or a
# tunnel, where the proxy forwards its public name as the Host header. Leave it
# unset for ordinary localhost work; the dev server then accepts localhost only.
#
# DEV_ALLOWED_HOSTS=pets.example.dev,other.example.dev

# Production API origin (public value). Set in GitHub as the `APEX_API_ORIGIN`
# repository variable; `deploy.yml` injects it as `VITE_API_ORIGIN` at build
# time on `main`, and fails fast when it is missing. Preview builds omit it
# and stay offline-only.
#
# APEX_API_ORIGIN=https://apex-api.ansyar-world.top
# Client API origin (build-time constant; unset = offline-only client). Local
# development points at the local API below.
#
# VITE_API_ORIGIN=http://localhost:3457
# API port (Coolify runs 3000; local development uses 3457 beside Vite on 5173).
#
# PORT=3457
# SQLite file (Coolify: /data/apex.sqlite on the apex-data volume).
#
# DATABASE_PATH=./data/apex.sqlite
# The one browser origin the API answers (Coolify runtime; exact match, never
# `*`). Local development allows the Vite dev server.
#
# ALLOWED_ORIGIN=http://localhost:5173
