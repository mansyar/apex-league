{
  "name": "apex-league",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @apex/client dev",
    "build": "bun run --filter @apex/client build",
    "check": "bun run --filter '*' check",
    "test": "bun test",
    "gate:determinism": "bun packages/voxel/scripts/determinism-gate.ts",
    "verify": "bun run check && bun test --check && biome check && bun run gate:determinism"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
