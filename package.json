{
  "name": "apex-league",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @apex/client dev",
    "build": "bun run --filter @apex/client build",
    "deploy": "bunx wrangler pages deploy",
    "check": "bun run --filter '*' check",
    "test": "bun test --timeout 120000",
    "test:phase": "bun test --check --parallel=4 --timeout 120000",
    "test:fuzz": "APEX_FUZZ_SWEEP=full bun test --check --parallel --timeout 120000 packages/voxel/src/fuzz",
    "gate:determinism": "bun packages/voxel/scripts/determinism-gate.ts",
    "verify": "bun run check && bun test --check --parallel --timeout 120000 && biome check && bun run gate:determinism"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "4.152.0"
  }
}
